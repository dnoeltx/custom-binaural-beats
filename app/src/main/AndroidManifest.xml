<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission, by design. The app has no network code at all
         (FR-027, constitution VIII). Playback permissions arrive with the
         foreground service in a later task. -->

    <application
        android:allowBackup="true"
        android:label="Binaural Beats"
        android:supportsRtl="true" />

</manifest>
